DISCORD_TOKEN=pune_tokenul_botului
DISCORD_GUILD_ID=1505903653079351357
ALLOWED_ROLE_IDS=1505905849774641243,1519377368354132110,1505906085901504522

# Railway: creeaza un volume si foloseste DATA_DIR=/data pentru configuratie persistenta.
DATA_DIR=./data

# Verificare automata notificari. Minim recomandat: 60 secunde.
CHECK_INTERVAL_SECONDS=120

# Necesare pentru notificari live Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Necesara pentru YouTube Live si pentru rezolvarea handle-urilor YouTube.
YOUTUBE_API_KEY=

# Necesara pentru live TikTok automat prin TikTools.
TIKTOOL_API_KEY=

# Optional. Pentru TikTok/feed-uri prin RSSHub, exemplu: https://rsshub.app
RSSHUB_URL=
# Dashboard web. Obligatorie pentru a deschide site-ul.
DASHBOARD_PASSWORD=schimba_aceasta_parola
DASHBOARD_SECRET=
